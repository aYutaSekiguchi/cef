+void QnxFrameImporter::EnsureGLExtensionsResolved() {
+  if (gl_extensions_resolved_) {
+    return;
+  }
+  if (IsQnxGpuTraceEnabled()) {
+    LOG(INFO) << "QNX_OZONE_GPU_TRACE EnsureGLExtensionsResolved: ENTERED "
+                 "(current context should be live)";
+  }
+  // Safe to call glGetString now: caller has just made an EGL context
+  // current via eglMakeCurrent (either the existing-state path or the
+  // new-state path in GetOrCreateWindowState). The Khronos spec says
+  // glGetString returns NULL with GL_INVALID_OPERATION if no context is
+  // current; QEMU virgl Mesa instead dereferences loader state and
+  // crashes the process, hence the deferral.
+  const char* gl_exts =
+      reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+  if (IsQnxGpuTraceEnabled()) {
+    LOG(INFO) << "QNX_OZONE_GPU_TRACE EnsureGLExtensionsResolved: "
+                 "glGetString_done gl_exts="
+              << static_cast<const void*>(gl_exts);
+  }
+  if (gl_exts) {
+    DLOG(INFO) << "GL_EXTENSIONS: " << gl_exts;
+  } else {
+    DLOG(WARNING) << "GL_EXTENSIONS: glGetString returned null after "
+                     "eglMakeCurrent (driver may not advertise any)";
+  }
+  has_gl_oes_egl_image_ =
+      gl_exts && strstr(gl_exts, "GL_OES_EGL_image") != nullptr;
+  has_khr_gl_texture_2d_ =
+      gl_exts && strstr(gl_exts, "GL_KHR_gl_texture_2d") != nullptr;
+
+  // Resolve the GL extension function pointer. eglGetProcAddress itself
+  // does not require a current context, but we group the call with the
+  // GL extension string probe to keep the GL-side resolution atomic and
+  // make it easy to verify ordering in the trace logs.
+  gl_egl_image_target_texture_2d_oes_ =
+      Resolve<GlEGLImageTargetTexture2DOESFn*>("glEGLImageTargetTexture2DOES");
+
+  gl_extensions_resolved_ = true;
+
+  if (IsQnxGpuTraceEnabled()) {
+    LOG(INFO) << "QNX_OZONE_GPU_TRACE EnsureGLExtensionsResolved: COMPLETE "
+                 "has_gl_oes_egl_image=" << has_gl_oes_egl_image_
+              << " has_khr_gl_texture_2d=" << has_khr_gl_texture_2d_
+              << " glEGLImageTargetTexture2DOES="
+              << reinterpret_cast<void*>(gl_egl_image_target_texture_2d_oes_);
+  }
+}
