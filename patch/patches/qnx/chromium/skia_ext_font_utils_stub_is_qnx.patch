+  } else if (is_qnx) {
+    # QNX is `is_linux = false` on the is_linux=false experiment branch, so
+    # it no longer falls into the Linux/ChromeOS block above. QNX does not
+    # define __linux / __GLIBC__ / __unix__, so third_party/skia's
+    # include/private/base/SkFeatures.h platform auto-detection would
+    # otherwise fall into its `else` branch and define SK_BUILD_FOR_MAC.
+    # That would make `src/utils/mac/SkCTFont.cpp` and friends (kept in
+    # skia_utils_private unconditionally) #import
+    # ApplicationServices/ApplicationServices.h and
+    # src/base/SkSemaphore.cpp #include <dispatch/dispatch.h>, neither of
+    # which QNX SDP 8 ships. Pre-define SK_BUILD_FOR_UNIX so the auto-detect
+    # block is skipped entirely and QNX reuses the Linux gamma settings.
+    defines += [
+      "SK_BUILD_FOR_UNIX",
+      "SK_GAMMA_EXPONENT=1.2",
+      "SK_GAMMA_CONTRAST=0.2",
+    ]
+  } else if (is_qnx) {
+    # QNX is `is_linux = false` on the is_linux=false experiment branch, so
+    # it no longer falls into the Linux/ChromeOS block above. QNX does not
+    # define __linux / __GLIBC__ / __unix__, so third_party/skia's
+    # include/private/base/SkFeatures.h platform auto-detection would
+    # otherwise fall into its `else` branch and define SK_BUILD_FOR_MAC.
+    # That would make `src/utils/mac/SkCTFont.cpp` and friends (kept in
+    # skia_utils_private unconditionally) #import
+    # ApplicationServices/ApplicationServices.h and
+    # src/base/SkSemaphore.cpp #include <dispatch/dispatch.h>, neither of
+    # which QNX SDP 8 ships. Pre-define SK_BUILD_FOR_UNIX so the auto-detect
+    # block is skipped entirely and QNX reuses the Linux gamma settings.
+    defines += [
+      "SK_BUILD_FOR_UNIX",
+      "SK_GAMMA_EXPONENT=1.2",
+      "SK_GAMMA_CONTRAST=0.2",
+    ]
+  } else if (is_qnx) {
+    # QNX is `is_linux = false` on the is_linux=false experiment branch, so
+    # it no longer falls into the Linux/ChromeOS block above. QNX does not
+    # define __linux / __GLIBC__ / __unix__, so third_party/skia's
+    # include/private/base/SkFeatures.h platform auto-detection would
+    # otherwise fall into its `else` branch and define SK_BUILD_FOR_MAC.
+    # That would make `src/utils/mac/SkCTFont.cpp` and friends (kept in
+    # skia_utils_private unconditionally) #import
+    # ApplicationServices/ApplicationServices.h and
+    # src/base/SkSemaphore.cpp #include <dispatch/dispatch.h>, neither of
+    # which QNX SDP 8 ships. Pre-define SK_BUILD_FOR_UNIX so the auto-detect
+    # block is skipped entirely and QNX reuses the Linux gamma settings.
+    defines += [
+      "SK_BUILD_FOR_UNIX",
+      "SK_GAMMA_EXPONENT=1.2",
+      "SK_GAMMA_CONTRAST=0.2",
+    ]
   } else if (is_android) {
     defines += [
       "SK_BUILD_FOR_ANDROID",
@@ -609,6 +660,9 @@ component("skia") {
