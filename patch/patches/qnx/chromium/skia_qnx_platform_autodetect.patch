diff --git include/private/base/SkFeatures.h include/private/base/SkFeatures.h
--- include/private/base/SkFeatures.h
+++ include/private/base/SkFeatures.h
@@ -26,8 +26,20 @@
           defined(__DragonFly__) || defined(__Fuchsia__) || \
           defined(__GLIBC__) || defined(__GNU__) || defined(__unix__)
         #define SK_BUILD_FOR_UNIX
+    #elif defined(__QNX__) || defined(__QNXNTO__)
+        // QNX SDP 8 ships a POSIX-2008 libc that exposes newlocale /
+        // uselocale / freelocale via <locale.h>. Chromium's current QNX
+        // baseline sets is_linux = (current_os == "linux" || is_qnx)
+        // in build/config/BUILDCONFIG.gn but does not predefine
+        // SK_BUILD_FOR_UNIX for the chromium-side skia config, and
+        // without this elif the auto-detect falls into the else
+        // SK_BUILD_FOR_MAC branch, which makes mac/utils headers like
+        // <xlocale.h> unconditionally attempted at compile time and
+        // breaks the QNX content_shell build with 'xlocale.h file not
+        // found'. Treat QNX as Unix.
+        #define SK_BUILD_FOR_UNIX
     #elif TARGET_OS_IPHONE || TARGET_IPHONE_SIMULATOR
         #define SK_BUILD_FOR_IOS
     #else
         #define SK_BUILD_FOR_MAC
     #endif
