diff --git a/third_party/libdrm/BUILD.gn b/third_party/libdrm/BUILD.gn
index 16ce474e5cdb91d8a6e55f2f1aa771a47c141239..9f27b5ff5119ae3851ce0cf182b11726d65b1971 100644
--- a/third_party/libdrm/BUILD.gn
+++ b/third_party/libdrm/BUILD.gn
@@ -82,6 +82,14 @@ static_library("libdrm") {
     "-Wno-deprecated-declarations",
   ]
 
+  if (is_qnx) {
+    # QNX declares open_memstream() in <sys/memstream.h> instead of
+    # <stdio.h>, and the symbol lives in libmemstream rather than libc.
+    # xf86drm.c uses open_memstream() to format DRM modifier names, so
+    # QNX builds need an explicit link against -lmemstream.
+    libs = [ "memstream" ]
+  }
+
   public_configs = [ ":libdrm_config" ]
 }
 
diff --git a/third_party/libdrm/src/xf86drm.c b/third_party/libdrm/src/xf86drm.c
index d4bfec8a41ba785ff4b8d917669c8bbea214b36e..78e213cfd13e842a6c929ac9a6dc6f3d362471fc 100644
