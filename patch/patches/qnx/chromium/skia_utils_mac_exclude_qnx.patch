diff --git BUILD.gn BUILD.gn
--- BUILD.gn
+++ BUILD.gn
@@ -1882,4 +1882,24 @@ component("skia") {
   sources += skia_utils_private
+  if (is_qnx) {
+    # QNX has no CoreText / CoreGraphics. SK_BUILD_FOR_UNIX define alone
+    # does not stop the mac/utils headers from including
+    # ApplicationServices. Exclude them from sources to avoid the
+    # 'ApplicationServices/ApplicationServices.h' file-not-found error
+    # on content_shell. Chrome root has no callers of these APIs on QNX
+    # (skia/ext/skia_utils_mac.mm is .mm and Mac-only). Use the same
+    # $_src-rooted absolute paths as gn/utils.gni so source-set
+    # subtraction matches the strings actually stored in skia_utils_private.
+    sources -= [
+      "$_src/utils/mac/SkCGBase.h",
+      "$_src/utils/mac/SkCGGeometry.h",
+      "$_src/utils/mac/SkCTFont.cpp",
+      "$_src/utils/mac/SkCTFont.h",
+      "$_src/utils/mac/SkCTFontCreateExactCopy.cpp",
+      "$_src/utils/mac/SkCTFontCreateExactCopy.h",
+      "$_src/utils/mac/SkCreateCGImageRef.cpp",
+      "$_src/utils/mac/SkUniqueCFRef.h",
+    ]
+  }
   sources += skia_utils_chromium
   sources += skia_effects_sources
   sources += skia_colorfilters_sources
