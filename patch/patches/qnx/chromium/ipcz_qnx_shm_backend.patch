--- third_party/ipcz/src/reference_drivers/object.h
+++ third_party/ipcz/src/reference_drivers/object.h
@@ -24,6 +24,11 @@ class Object : public RefCounted<Object> {
 #if defined(OS_LINUX)
     // A non-standard driver object type which wraps a FileDescriptor object.
     kFileDescriptor,
+#elif defined(OS_QNX)
+    // QNX counterpart of kFileDescriptor. QNX has no memfd_create or fcntl
