 #define IPCZ_SRC_REFERENCE_DRIVERS_WRAPPED_FILE_DESCRIPTOR_H_
 
+#include "build/build_config.h"
 #include "reference_drivers/file_descriptor.h"
 #include "reference_drivers/object.h"
 
@@ -12,11 +13,19 @@ namespace ipcz::reference_drivers {
 
 // Wraps a FileDescriptor as a driver object. The Linux multiprocess reference
 // driver uses this to facilitate serialization of more complex objects into
-// these readily transmissible objects.
+// these readily transmissible objects. On QNX, which lacks memfd_create and
+// fcntl seals, the same shim is re-typed as Object::kQnxShmHandle so the
+// underlying FileDescriptor (carrying a shm_open fd) stays object-identical
+// but is exposed under a QNX-specific Object type for downstream
+// serialization that may eventually need to emit shm_open_handle() tokens.
 class WrappedFileDescriptor
+#if BUILDFLAG(IS_QNX)
+    : public ObjectImpl<WrappedFileDescriptor, Object::kQnxShmHandle> {
+#else
     : public ObjectImpl<WrappedFileDescriptor, Object::kFileDescriptor> {
+#endif
  public:
-  explicit WrappedFileDescriptor(FileDescriptor fd);
+  explicit WrappedFileDescriptor(FileDescriptor fd) : fd_(std::move(fd)) {}
 
   const FileDescriptor& handle() const { return fd_; }
   FileDescriptor TakeDescriptor() { return std::move(fd_); }
@@ -31,7 +40,7 @@ class WrappedFileDescriptor
   }
 
  private:
-  ~WrappedFileDescriptor() override;
+  ~WrappedFileDescriptor() override = default;
 
   FileDescriptor fd_;
 };
