+#if BUILDFLAG(IS_QNX)
+// QNX input fix (Phase 6): forward mouse events from NativeViewHost to the
+// hosted aura::Window children (e.g. RWHVA). On QNX the hosted NativeView
+// is not reachable by WED hit-test, so the events stop at NativeViewHost.
+// We dispatch the event (with coordinates converted to each child's space)
+// to every child's delegate. Children that have an OnMouseEvent override
+// (RWHVA does) will process the event and send it to the renderer.
+//
+// Press/release of mouse buttons other than left (e.g. right-click
+// button=2 or middle button=1) are NOT forwarded. Forwarding the
+// right-click contextmenu to the renderer caused Chromium/CEF to create a
+// native context-menu QnxWindow, which then hit a QNX Screen API
+// ENOENT in `change_new_window_visibility` and crashed the cefsimple
+// process with `trace trap` (exit 133, SIGTRAP) after a few seconds of
+// continuous GPU frame submissions. Skipping non-left press/release
+// keeps the input-routing fix but avoids that crash.
+void NativeViewHost::ForwardMouseEventToHostedViews(
+    const ui::MouseEvent& event) {
+  if (!native_view_)
+    return;
+  const ui::EventType type = event.type();
+  if (type == ui::EventType::kMousePressed || type == ui::EventType::kMouseReleased) {
+    if (event.changed_button_flags() != ui::EF_LEFT_MOUSE_BUTTON) {
+      return;
+    }
+  }
+  // QNX: skip events that landed outside the NativeViewHost's bounds. The
+  // Widget-level dispatch can route off-screen events to NativeViewHost via
+  // the View hit-test fallback even when the cursor is far outside the
+  // window. Forwarding those to RWHVA produced a continuous compositor
+  // redraw loop on QNX (because the renderer kept invalidating per
+  // synthetic event), eventually crashing the GPU process with `trace
+  // trap` (SIGTRAP, exit 133). Restricting to in-bounds events keeps the
+  // input fix intact while avoiding the redraw storm.
+  if (!bounds().Contains(event.location())) {
+    return;
+  }
+  ui::MouseEvent forwarded = event;
+  gfx::Point root_loc = event.location();
+  if (GetWidget() && GetWidget()->GetNativeView()) {
+    aura::Window::ConvertPointToTarget(GetWidget()->GetNativeView(),
+                                      native_view_, &root_loc);
+  }
+  forwarded.set_location(root_loc);
+  forwarded.set_root_location(root_loc);
+  int child_count = 0;
+  for (aura::Window* child : native_view_->children()) {
+    if (auto* child_delegate = child->delegate()) {
+      child_delegate->OnEvent(&forwarded);
+      child_count++;
+    }
+  }
+  static int qnx_nvh_forward_count = 0;
+  if (qnx_nvh_forward_count < 5) {
+    qnx_nvh_forward_count++;
+    LOG(INFO) << "[QNX_INPUT_BOUNDARY] NativeViewHost forward done"
+              << " type=" << static_cast<int>(event.type())
+              << " flags=" << event.changed_button_flags()
+              << " fwd_handled=" << forwarded.handled()
+              << " fwd_loc=" << root_loc.ToString()
+              << " children_count=" << child_count;
+  }
+}
+#endif
+
+void NativeViewHost::OnMouseEvent(ui::MouseEvent* event) {
+#if BUILDFLAG(IS_QNX)
+  // QNX input fix (Phase 6): forward to hosted view BEFORE View::OnMouseEvent
+  // processes the event, so the renderer gets the event. We then call the
+  // base class implementation so the View hierarchy (and the Widget above
+  // it) still sees the event normally. This is critical for right-clicks
+  // where the BrowserWidget needs to set mouse capture to coordinate
+  // native popup windows (context menus) -- returning true from a typed
+  // handler override causes the Widget to call SetCapture(), which would
+  // prevent the context-menu QnxWindow from receiving mouse events.
+  ForwardMouseEventToHostedViews(*event);
+#endif
