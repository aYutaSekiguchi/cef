+void Window::SetDelegate(WindowDelegate* delegate) {
+  // Replaces the WindowDelegate after construction. Used by QNX's
+  // BrowserNativeWidgetAuraQnx to attach itself as the delegate of the
+  // root aura::Window (the one constructed with delegate=nullptr by
+  // WindowTreeHostPlatform::Create), so events flowing through
+  // Window::CanAcceptEvent/OnEvent reach a handler instead of being
+  // silently dropped (Phase 6 QNX input fix).
+  if (delegate_ == delegate)
+    return;
+  delegate_ = delegate;
+  SetTargetHandler(delegate);
+}
+
 const std::u16string& Window::GetTitle() const {
   std::u16string* title = GetProperty(client::kTitleKey);
   return title ? *title : base::EmptyString16();
