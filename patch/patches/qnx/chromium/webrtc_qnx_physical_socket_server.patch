diff --git third_party/webrtc/rtc_base/physical_socket_server.cc third_party/webrtc/rtc_base/physical_socket_server.cc
--- third_party/webrtc/rtc_base/physical_socket_server.cc
+++ third_party/webrtc/rtc_base/physical_socket_server.cc
@@ -63,11 +63,11 @@
 #include <ws2tcpip.h>
 
 #undef SetPort
 #endif
 
-#if defined(WEBRTC_LINUX)
+#if defined(WEBRTC_LINUX) && !defined(__QNX__)
 #include <asm-generic/socket.h>
 #include <linux/sockios.h>
 #include <sys/epoll.h>
 #endif
 
@@ -80,11 +80,11 @@
 #if defined(WEBRTC_POSIX)
 #define IP_MTU 14  // Until this is integrated from linux/in.h to netinet/in.h
 typedef void* SockOptArg;
 #endif  // WEBRTC_POSIX
 
-#if defined(WEBRTC_POSIX) && !defined(WEBRTC_MAC)
+#if defined(WEBRTC_POSIX) && !defined(WEBRTC_MAC) && !defined(__QNX__)
 int64_t GetSocketRecvTimestamp(int socket) {
   struct timeval tv_ioctl;
   int ret = ioctl(socket, SIOCGSTAMP, &tv_ioctl);
   if (ret != 0)
     return -1;
@@ -334,11 +334,11 @@ int PhysicalSocket::GetOption(Option opt, int* value) {
   int ret = ::getsockopt(s_, slevel, sopt, (SockOptArg)value, &optlen);
   if (ret == -1) {
     return -1;
   }
   if (opt == OPT_DONTFRAGMENT) {
-#if defined(WEBRTC_LINUX) && !defined(WEBRTC_ANDROID)
+#if defined(WEBRTC_LINUX) && !defined(WEBRTC_ANDROID) && !defined(__QNX__)
     *value = (*value != IP_PMTUDISC_DONT) ? 1 : 0;
 #endif
   } else if (opt == OPT_DSCP) {
 #if defined(WEBRTC_POSIX)
     // unshift DSCP value to get six most significant bits of IP DiffServ field
@@ -363,11 +363,11 @@ int PhysicalSocket::SetOption(Option opt, int value) {
   int slevel;
   int sopt;
   if (TranslateOption(opt, &slevel, &sopt) == -1)
     return -1;
   if (opt == OPT_DONTFRAGMENT) {
-#if defined(WEBRTC_LINUX) && !defined(WEBRTC_ANDROID)
+#if defined(WEBRTC_LINUX) && !defined(WEBRTC_ANDROID) && !defined(__QNX__)
     value = (value) ? IP_PMTUDISC_DO : IP_PMTUDISC_DONT;
 #endif
   } else if (opt == OPT_DSCP) {
     // IP DiffServ  consists of DSCP 6 most significant, ECN 2 least
     // significant.
@@ -707,14 +707,19 @@ int PhysicalSocket::TranslateOption(Option opt, int* slevel, int* sopt) {
       *sopt = IP_DONTFRAGMENT;
       break;
 #elif defined(WEBRTC_MAC) || defined(BSD)
       RTC_LOG(LS_WARNING) << "Socket::OPT_DONTFRAGMENT not supported.";
       return -1;
