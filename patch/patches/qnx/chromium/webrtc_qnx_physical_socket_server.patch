+#elif defined(WEBRTC_POSIX) && !defined(__QNX__)
       *slevel = IPPROTO_IP;
       *sopt = IP_MTU_DISCOVER;
       break;
+#elif defined(__QNX__)
+      // QNX SDP 8 has no IP_MTU_DISCOVER; pretend the option is
+      // unsupported so callers fall through gracefully.
+      RTC_LOG(LS_WARNING) << "Socket::OPT_DONTFRAGMENT not supported.";
+      return -1;
 #endif
     case OPT_RCVBUF:
       *slevel = SOL_SOCKET;
       *sopt = SO_RCVBUF;
       break;
@@ -789,11 +794,11 @@ int PhysicalSocket::TranslateOption(Option opt, int* slevel, int* sopt) {
     case OPT_TCP_KEEPINTVL:
       *slevel = IPPROTO_TCP;
       *sopt = TCP_KEEPINTVL;
       break;
     case OPT_TCP_USER_TIMEOUT:
-#if defined(WEBRTC_LINUX) || defined(WEBRTC_ANDROID)
+#if (defined(WEBRTC_LINUX) || defined(WEBRTC_ANDROID)) && !defined(__QNX__)
       *slevel = IPPROTO_TCP;
       *sopt = TCP_USER_TIMEOUT;
       break;
 #else
       RTC_LOG(LS_WARNING) << "Socket::OPT_TCP_USER_TIMEOUT not supported.";
