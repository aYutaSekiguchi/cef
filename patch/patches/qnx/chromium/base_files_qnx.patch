+template <typename ResizeFn, typename SpanFn>
+bool ReadFileToContainerWithMaxSizeQnx(const FilePath& path,
+                                       size_t max_size,
+                                       ResizeFn&& resize,
+                                       SpanFn&& span_fn) {
+  File file(path, File::FLAG_OPEN | File::FLAG_READ);
+  if (!file.IsValid()) {
+    return false;
+  }
+
+  constexpr size_t kDefaultChunkSize = 1 << 16;
+  constexpr size_t kSmallChunkSize = 4096;
+  const bool unlimited = max_size == std::numeric_limits<size_t>::max();
+  size_t chunk_size = kSmallChunkSize - 1;
+  File::Info file_info;
+  if (file.GetInfo(&file_info) && file_info.size > 0) {
+    chunk_size = static_cast<size_t>(file_info.size);
+  }
+  if (!unlimited) {
+    chunk_size = std::min(chunk_size, max_size);
+  }
+  chunk_size += 1;
+
+  size_t bytes_read_so_far = 0;
+  bool read_status = true;
+  resize(chunk_size);
+  span<uint8_t> bytes_span = span_fn();
+
+  while (true) {
+    const size_t remaining = bytes_span.size() - bytes_read_so_far;
+    auto read =
+        file.ReadAtCurrentPos(bytes_span.subspan(bytes_read_so_far, remaining));
+    if (!read.has_value()) {
+      return false;
+    }
+    if (*read == 0) {
+      break;
+    }
+    bytes_read_so_far += *read;
+    if (!unlimited && bytes_read_so_far > max_size) {
+      break;
+    }
+    if (bytes_read_so_far == bytes_span.size()) {
+      chunk_size = kDefaultChunkSize;
+      if (!unlimited) {
+        chunk_size = std::min(chunk_size, max_size - bytes_read_so_far);
+      }
+      chunk_size += 1;
+      resize(bytes_read_so_far + chunk_size);
+      bytes_span = span_fn();
+    }
+  }
+
+  if (!unlimited && bytes_read_so_far > max_size) {
+    bytes_read_so_far = max_size;
+    read_status = false;
+  }
+  resize(bytes_read_so_far);
+  return read_status;
