+bool QnxRenderProducer::PaintSolidColorToDmaBuf(EGLImageKHR image,
+                                                const gfx::Size& size) {
+  // Bail out cleanly if any pre-condition for the FBO render is missing.
+  // The exported DMAbuf will then be uninitialized (black) but the rest
+  // of the export pipeline still completes — this is the same behavior
+  // the Phase 1B-exportonly probe had before this helper was added.
+  if (!is_valid_) {
+    DLOG(WARNING) << "QnxRenderProducer::PaintSolidColorToDmaBuf: producer "
+                     "not initialized; skipping";
+    return false;
+  }
+  if (!gl_egl_image_target_texture_2d_oes_) {
+    DLOG(WARNING)
+        << "QnxRenderProducer::PaintSolidColorToDmaBuf: "
+           "glEGLImageTargetTexture2DOES not resolved; skipping";
+    return false;
+  }
+  // The producer is called from QnxGpuService::SubmitTestFrameForWidget
+  // which runs on the GPU process main thread.  The GPU main thread owns
+  // a GL context created by VizMainImpl, but it is *not* made current on
+  // the thread by default — VizMainImpl makes the GLContext current
+  // lazily on first use.  If no context is current yet, we skip the
+  // paint (the DMAbuf will be black, which is the legacy behavior).
+  if (!gl::GLContext::GetCurrent()) {
+    DLOG(WARNING) << "QnxRenderProducer::PaintSolidColorToDmaBuf: no "
+                     "current GL context on the GPU main thread; "
+                     "skipping (DMAbuf will be uninitialized)";
+    return false;
+  }
+
+  DLOG(INFO) << "QnxRenderProducer::PaintSolidColorToDmaBuf: painting sky "
+                 "blue into "
+              << size.width() << "x" << size.height() << " DMAbuf";
+
+  // 1. Bind the EGLImage as a 2D texture.  This is the GL_OES_EGL_image
+  // extension hook; without it we have no way to render into the DMAbuf
+  // that backs the EGLImage.
+  GLuint texture = 0;
+  glGenTextures(1, &texture);
+  if (texture == 0) {
+    DLOG(WARNING) << "QnxRenderProducer::PaintSolidColorToDmaBuf: "
+                     "glGenTextures returned 0";
+    return false;
+  }
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  gl_egl_image_target_texture_2d_oes_(GL_TEXTURE_2D,
+                                      static_cast<GLeglImageOES>(image));
+
+  // 2. Create a GLES2 framebuffer object (core in GLES2, no extension
+  // function pointer needed) with the EGLImage-bound texture as the
+  // sole color attachment.  After this returns, drawing into the
+  // framebuffer writes into the DMAbuf that backs |image|.
+  GLuint fbo = 0;
+  glGenFramebuffers(1, &fbo);
+  glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                         GL_TEXTURE_2D, texture, 0);
+
+  // 3. Sanity-check the FBO before clearing.  A non-complete FBO means
+  // the driver rejected our attachment (size/format mismatch) and the
+  // glClear would silently no-op, leaving the DMAbuf black anyway.
+  GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+  if (status != GL_FRAMEBUFFER_COMPLETE) {
+    DLOG(WARNING) << "QnxRenderProducer::PaintSolidColorToDmaBuf: FBO "
+                     "incomplete: status=0x"
+                  << std::hex << status << std::dec
+                  << " (DMAbuf left uninitialized)";
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDeleteFramebuffers(1, &fbo);
+    glDeleteTextures(1, &texture);
+    return false;
+  }
+
+  // 4. Clear the framebuffer to sky blue.  glClear fills every pixel
+  // of the FBO's color attachment(s) with the color set by glClearColor.
+  // The texture (and therefore the DMAbuf that backs it) now contains
+  // a solid RGBA(0, 0.498, 1.0, 1.0) image, which the browser-side
+  // QnxFrameImporter will sample and present to the Screen surface.
+  glClearColor(0.0f, 0.498f, 1.0f, 1.0f);  // sky blue
+  glClear(GL_COLOR_BUFFER_BIT);
+  // Make sure the clear is flushed to the GPU before we tear down the
+  // FBO/texture bindings.  Without glFlush, some drivers defer the
+  // clear and a later eglExportDMABUFImageMESA could race with it.
+  glFlush();
+
+  // 5. Unbind and delete the FBO + texture.  Important: the texture is
+  // *not* deleted yet because we still need the EGLImage binding alive
+  // for the export below.  The order matters — delete texture would
+  // unbind the EGLImage, and eglExportDMABUFImageMESA might then
+  // observe a different (uninitialized) backing.
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glDeleteFramebuffers(1, &fbo);
+  // Keep texture alive until after eglExportDMABUFImageMESA; the
+  // CreateExportFrame caller owns the destruction order via EGLImage
+  // lifetime (eglDestroyImageKHR is called after eglExportDMABUFImageMESA
+  // succeeds, which detaches the texture from the now-exported DMAbuf).
+  // We do release the binding here to keep state clean for any subsequent
+  // GL operations.
+  glBindTexture(GL_TEXTURE_2D, 0);
+  glDeleteTextures(1, &texture);
+
+  DLOG(INFO) << "QnxRenderProducer::PaintSolidColorToDmaBuf: sky blue "
+                 "painted into widget="
+              << widget_ << " DMAbuf " << size.width() << "x" << size.height();
+  return true;
+}
