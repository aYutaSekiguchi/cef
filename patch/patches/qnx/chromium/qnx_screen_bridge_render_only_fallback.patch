+                                    &stride) == 0 &&
+      stride > 0) {
+    out_desc->stride = static_cast<uint32_t>(stride);
+  }
+
+  int buffer_size = 0;
+  if (screen_get_buffer_property_iv(screen_buffer_, SCREEN_PROPERTY_BUFFER_SIZE,
+                                    &buffer_size) == 0 &&
+      buffer_size > 0) {
+    out_desc->size = static_cast<uint64_t>(buffer_size);
+  }
+
+  int screen_format = 0;
+  if (screen_get_buffer_property_iv(screen_buffer_, SCREEN_PROPERTY_FORMAT,
+                                    &screen_format) == 0 &&
+      screen_format > 0x00ffffff) {
+    out_desc->fourcc = static_cast<uint32_t>(screen_format);
