+void QnxGpuService::OnCompositorPreSwap(const gfx::Size& size) {
+  LOG(INFO) << "[QNX-TRACE] QnxGpuService::OnCompositorPreSwap: entered "
+               "size="
+            << size.width() << "x" << size.height();
+  if (!gpu_host_remote_ || !producer_manager_ ||
+      compositor_widget_ == gfx::kNullAcceleratedWidget ||
+      compositor_generation_ == 0) {
+    return;
+  }
+  if (compositor_frame_in_flight_) {
+    LOG(INFO) << "[QNX-TRACE] QnxGpuService::OnCompositorPreSwap: dropping "
+                 "frame while previous submission is in flight";
+    return;
+  }
+
+  QnxRenderProducer* producer = producer_manager_->GetProducer(
+      compositor_widget_, compositor_generation_);
+  if (!producer || !producer->is_valid())
+    return;
+
+  compositor_frame_in_flight_ = true;
+  auto [frame, error] = producer->CreateExportFrameFromCompositor();
+  if (!error.empty()) {
+    compositor_frame_in_flight_ = false;
+    LOG(INFO) << "[QNX-TRACE] QnxGpuService::OnCompositorPreSwap: widget="
+                 << compositor_widget_ << " generation="
+                 << compositor_generation_ << " capture deferred: " << error;
+    return;
+  }
+  if (frame.planes.empty()) {
+    compositor_frame_in_flight_ = false;
+    return;
+  }
+
+  LOG(INFO) << "[QNX-TRACE] QnxGpuService::OnCompositorPreSwap: "
+               "submitting compositor frame widget="
+            << compositor_widget_ << " generation=" << compositor_generation_
+            << " size=" << size.width() << "x" << size.height();
+  qnx::QnxDmaBufFramePtr mojom_frame = NativeFrameToMojomFrame(frame);
+  gpu_host_remote_->SubmitFrame(
+      std::move(mojom_frame),
+      base::BindOnce(
+          [](base::WeakPtr<QnxGpuService> service,
+             gfx::AcceleratedWidget widget, uint32_t generation, bool accepted,
+             const std::string& diagnostic) {
+            if (service)
+              service->compositor_frame_in_flight_ = false;
+            LOG(INFO) << "[QNX-TRACE] QnxGpuService::OnCompositorPreSwap: "
+                         "completion widget="
+                      << widget << " generation=" << generation
+                      << " accepted=" << accepted << " diagnostic="
+                      << diagnostic;
+          },
+          weak_ptr_factory_.GetWeakPtr(), compositor_widget_,
+          compositor_generation_));
+}
