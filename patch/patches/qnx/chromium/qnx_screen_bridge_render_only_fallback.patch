+bool QnxRenderProducer::InitializeScreenBridge(std::string* out_error) {
+  if (out_error) {
+    out_error->clear();
+  }
+
+  if (screen_context_ && screen_pixmap_ && screen_buffer_) {
+    return true;
+  }
+
+  if (!gl_egl_image_target_texture_2d_oes_) {
+    gl_egl_image_target_texture_2d_oes_ =
+        ResolveEGL<GlEGLImageTargetTexture2DOESFn>(
+            "glEGLImageTargetTexture2DOES");
+    has_gl_oes_egl_image_ = (gl_egl_image_target_texture_2d_oes_ != nullptr);
+  }
+
+  screen_context_t new_context = nullptr;
+  screen_pixmap_t new_pixmap = nullptr;
+  screen_buffer_t new_buffer = nullptr;
+
+  if (screen_create_context(&new_context, SCREEN_APPLICATION_CONTEXT) != 0) {
+    if (out_error) {
+      *out_error = "screen_create_context failed";
+    }
+    PLOG(ERROR) << "QnxRenderProducer::InitializeScreenBridge: "
+                << "screen_create_context failed";
+    return false;
+  }
+
+  if (screen_create_pixmap(&new_pixmap, new_context) != 0) {
+    if (out_error) {
+      *out_error = "screen_create_pixmap failed";
+    }
+    PLOG(ERROR) << "QnxRenderProducer::InitializeScreenBridge: "
+                << "screen_create_pixmap failed";
+    screen_destroy_context(new_context);
+    return false;
+  }
+
+  const int usage = SCREEN_USAGE_OPENGL_ES2 | SCREEN_USAGE_NATIVE |
+                    SCREEN_USAGE_READ | SCREEN_USAGE_WRITE;
+  if (screen_set_pixmap_property_iv(new_pixmap, SCREEN_PROPERTY_USAGE,
+                                    &usage) != 0) {
+    if (out_error) {
+      *out_error = "screen_set_pixmap_property_iv(USAGE) failed";
+    }
+    PLOG(ERROR) << "QnxRenderProducer::InitializeScreenBridge: "
+                << "set SCREEN_PROPERTY_USAGE failed";
+    screen_destroy_pixmap(new_pixmap);
+    screen_destroy_context(new_context);
+    return false;
+  }
+
+  const int format = SCREEN_FORMAT_RGBA8888;
+  if (screen_set_pixmap_property_iv(new_pixmap, SCREEN_PROPERTY_FORMAT,
+                                    &format) != 0) {
+    if (out_error) {
+      *out_error = "screen_set_pixmap_property_iv(FORMAT) failed";
+    }
+    PLOG(ERROR) << "QnxRenderProducer::InitializeScreenBridge: "
+                << "set SCREEN_PROPERTY_FORMAT failed";
+    screen_destroy_pixmap(new_pixmap);
+    screen_destroy_context(new_context);
+    return false;
+  }
+
+  const int buffer_size[2] = {size_.width(), size_.height()};
+  if (screen_set_pixmap_property_iv(new_pixmap, SCREEN_PROPERTY_BUFFER_SIZE,
+                                    buffer_size) != 0) {
+    if (out_error) {
+      *out_error = "screen_set_pixmap_property_iv(BUFFER_SIZE) failed";
+    }
+    PLOG(ERROR) << "QnxRenderProducer::InitializeScreenBridge: "
+                << "set SCREEN_PROPERTY_BUFFER_SIZE failed";
+    screen_destroy_pixmap(new_pixmap);
+    screen_destroy_context(new_context);
+    return false;
+  }
+
+  if (screen_create_pixmap_buffer(new_pixmap) != 0) {
+    if (out_error) {
+      *out_error = "screen_create_pixmap_buffer failed";
+    }
+    PLOG(ERROR) << "QnxRenderProducer::InitializeScreenBridge: "
+                << "screen_create_pixmap_buffer failed";
+    screen_destroy_pixmap(new_pixmap);
+    screen_destroy_context(new_context);
+    return false;
+  }
+
+  if (screen_get_pixmap_property_pv(
+          new_pixmap, SCREEN_PROPERTY_RENDER_BUFFERS,
+          reinterpret_cast<void**>(&new_buffer)) != 0 ||
+      !new_buffer) {
+    // Some BSPs expose pixmap buffers via SCREEN_PROPERTY_BUFFERS.
+    screen_get_pixmap_property_pv(new_pixmap, SCREEN_PROPERTY_BUFFERS,
+                                  reinterpret_cast<void**>(&new_buffer));
+  }
+
+  if (!new_buffer) {
+    if (out_error) {
+      *out_error = "screen_get_pixmap_property_pv(RENDER_BUFFERS) failed";
+    }
+    LOG(ERROR) << "QnxRenderProducer::InitializeScreenBridge: failed to get "
+                  "pixmap buffer handle";
+    screen_destroy_pixmap(new_pixmap);
+    screen_destroy_context(new_context);
+    return false;
+  }
+
+  screen_context_ = new_context;
+  screen_pixmap_ = new_pixmap;
+  screen_buffer_ = new_buffer;
+
+  DLOG(INFO) << "QnxRenderProducer::InitializeScreenBridge: ready for widget="
+             << widget_ << " size=" << size_.width() << "x" << size_.height();
+  return true;
+}
