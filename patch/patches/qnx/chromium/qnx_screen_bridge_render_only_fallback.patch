-  if (screen_get_buffer_property_iv(screen_buffer_, SCREEN_PROPERTY_FD, &fd) !=
-          0 ||
-      fd < 0) {
+  errno = 0;
+  const int fd_rc =
+      screen_get_buffer_property_iv(screen_buffer_, SCREEN_PROPERTY_FD, &fd);
+  if (fd_rc != 0 && errno == ENOTSUP) {
+    DLOG(INFO) << "QnxRenderProducer::BuildScreenBufferDescriptor: "
+                  "SCREEN_PROPERTY_FD not exposed by screen; using "
+                  "render-only frame";
+  } else if (fd_rc != 0 || fd < 0) {
     if (out_error) {
       *out_error = "SCREEN_PROPERTY_FD unavailable";
     }
@@ -519,15 +524,18 @@ bool QnxRenderProducer::BuildScreenBufferDescriptor(
     return false;
   }
 
-  const int dup_fd = HANDLE_EINTR(dup(fd));
-  if (dup_fd < 0) {
-    if (out_error) {
-      *out_error = "dup(SCREEN_PROPERTY_FD) failed";
+  if (fd >= 0) {
+    const int dup_fd = HANDLE_EINTR(dup(fd));
+    if (dup_fd < 0) {
+      if (out_error) {
+        *out_error = "dup(SCREEN_PROPERTY_FD) failed";
+      }
+      PLOG(ERROR)
+          << "QnxRenderProducer::BuildScreenBufferDescriptor: dup failed";
+      return false;
     }
-    PLOG(ERROR) << "QnxRenderProducer::BuildScreenBufferDescriptor: dup failed";
-    return false;
+    out_desc->fd.reset(dup_fd);
   }
-  out_desc->fd.reset(dup_fd);
 
   int stride = 0;
   if (screen_get_buffer_property_iv(screen_buffer_, SCREEN_PROPERTY_STRIDE,

