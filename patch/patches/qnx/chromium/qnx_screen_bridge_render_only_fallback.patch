+
+  if (!out_desc) {
+    if (out_error) {
+      *out_error = "out_desc is null";
+    }
+    return false;
+  }
+
+  if (!screen_buffer_) {
+    if (out_error) {
+      *out_error = "screen bridge buffer is not initialized";
