+bool QnxRenderProducer::PopulateFrameFromScreenDescriptor(
+    ScreenBufferDescriptor* desc,
+    QnxDmaBufFrame* out_frame,
+    std::string* out_error) {
+  if (out_error) {
+    out_error->clear();
+  }
+
+  if (!desc || !out_frame) {
+    if (out_error) {
+      *out_error = "invalid output arguments";
+    }
+    return false;
+  }
+
+  if (!desc->fd.is_valid()) {
+    if (out_error) {
+      *out_error = "descriptor fd is invalid";
+    }
+    return false;
+  }
+
+  out_frame->widget = widget_;
+  out_frame->generation = generation_;
+  out_frame->width = static_cast<uint32_t>(size_.width());
+  out_frame->height = static_cast<uint32_t>(size_.height());
+  out_frame->fourcc = desc->fourcc ? desc->fourcc : kDrmFormatArgb8888;
+  out_frame->modifier = desc->modifier;
+
+  QnxDmaBufPlane plane;
+  plane.fd = std::move(desc->fd);
+  plane.stride = desc->stride;
+  plane.offset = desc->offset;
+  plane.size = desc->size;
+
+  if (plane.size == 0 && plane.stride > 0) {
+    plane.size = static_cast<uint64_t>(plane.stride) *
+                 static_cast<uint64_t>(size_.height());
+  }
+
+  out_frame->planes.clear();
+  out_frame->planes.push_back(std::move(plane));
+
+  return true;
+}
