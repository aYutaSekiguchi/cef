+bool QnxRenderProducer::CaptureCurrentFramebufferToDmaBuf(
+    EGLImageKHR image,
+    const gfx::Size& size,
+    std::string* out_error) {
+  if (out_error)
+    out_error->clear();
+
+  LOG(INFO) << "[QNX-TRACE] QnxRenderProducer::CaptureCurrentFramebufferToDmaBuf: "
+               "begin widget="
+            << widget_ << " generation=" << generation_;
+  if (!gl::GLContext::GetCurrent()) {
+    if (out_error)
+      *out_error = "no current GL context at compositor completion";
+    LOG(INFO) << "[QNX-TRACE] QnxRenderProducer::CaptureCurrentFramebufferToDmaBuf: "
+                 "no current GL context";
+    return false;
+  }
+  if (!gl_egl_image_target_texture_2d_oes_) {
+    if (out_error)
+      *out_error = "glEGLImageTargetTexture2DOES is unavailable";
+    return false;
+  }
+  if (size.IsEmpty()) {
+    if (out_error)
+      *out_error = "compositor frame size is empty";
+    return false;
+  }
+
+  const size_t byte_count = static_cast<size_t>(size.width()) *
+                            static_cast<size_t>(size.height()) * 4u;
+  std::vector<uint8_t> pixels(byte_count);
+  GLint previous_pack_alignment = 4;
+  glGetIntegerv(GL_PACK_ALIGNMENT, &previous_pack_alignment);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glReadPixels(0, 0, size.width(), size.height(), GL_RGBA,
+               GL_UNSIGNED_BYTE, pixels.data());
+  GLenum error = glGetError();
+  glPixelStorei(GL_PACK_ALIGNMENT, previous_pack_alignment);
+  if (error != GL_NO_ERROR) {
+    if (out_error)
+      *out_error = "glReadPixels failed";
+    LOG(INFO) << "[QNX-TRACE] QnxRenderProducer::CaptureCurrentFramebufferToDmaBuf: "
+                 "glReadPixels failed";
+    DLOG(WARNING) << "QnxRenderProducer::CaptureCurrentFramebufferToDmaBuf: "
+                     "glReadPixels error=0x"
+                  << std::hex << error << std::dec;
+    return false;
+  }
+
+  GLint previous_texture_binding = 0;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous_texture_binding);
+  GLuint texture = 0;
+  glGenTextures(1, &texture);
+  if (texture == 0) {
+    if (out_error)
+      *out_error = "glGenTextures returned 0";
+    return false;
+  }
+
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  gl_egl_image_target_texture_2d_oes_(GL_TEXTURE_2D,
+                                      static_cast<GLeglImageOES>(image));
+  glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, size.width(), size.height(), GL_RGBA,
+                  GL_UNSIGNED_BYTE, pixels.data());
+  error = glGetError();
+  glBindTexture(GL_TEXTURE_2D,
+                static_cast<GLuint>(previous_texture_binding));
+  glDeleteTextures(1, &texture);
+  if (error != GL_NO_ERROR) {
+    if (out_error)
+      *out_error = "glTexSubImage2D into Mesa EGLImage failed";
+    LOG(INFO) << "[QNX-TRACE] QnxRenderProducer::CaptureCurrentFramebufferToDmaBuf: "
+                 "glTexSubImage2D failed";
+    DLOG(WARNING) << "QnxRenderProducer::CaptureCurrentFramebufferToDmaBuf: "
+                     "upload error=0x"
+                  << std::hex << error << std::dec;
+    return false;
+  }
+
+  glFlush();
+  LOG(INFO) << "[QNX-TRACE] QnxRenderProducer::CaptureCurrentFramebufferToDmaBuf: "
+               "captured compositor framebuffer widget="
+            << widget_ << " generation=" << generation_ << " size="
+            << size.width() << "x" << size.height();
+  return true;
+}
