+bool QnxRenderProducer::RenderSolidIntoScreenBuffer(
+    const ScreenBufferDescriptor& desc,
+    const gfx::Size& size,
+    std::string* out_error) {
+  if (out_error) {
+    out_error->clear();
+  }
+
+  if (!desc.native_image) {
+    if (out_error) {
+      *out_error = "native_image is null";
+    }
+    return false;
+  }
+
+  if (!gl_egl_image_target_texture_2d_oes_) {
+    if (out_error) {
+      *out_error = "glEGLImageTargetTexture2DOES not resolved";
+    }
+    return false;
+  }
+
+  if (!gl::GLContext::GetCurrent()) {
+    if (out_error) {
+      *out_error = "no current GL context";
+    }
+    return false;
+  }
+
+  GLuint texture = 0;
+  glGenTextures(1, &texture);
+  if (texture == 0) {
+    if (out_error) {
+      *out_error = "glGenTextures returned 0";
+    }
+    return false;
+  }
+
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  gl_egl_image_target_texture_2d_oes_(GL_TEXTURE_2D, desc.native_image);
+
+  GLuint fbo = 0;
+  glGenFramebuffers(1, &fbo);
+  glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                         texture, 0);
+
+  const GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+  if (status != GL_FRAMEBUFFER_COMPLETE) {
+    if (out_error) {
+      *out_error = "FBO incomplete";
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDeleteFramebuffers(1, &fbo);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glDeleteTextures(1, &texture);
+    return false;
+  }
+
+  glViewport(0, 0, size.width(), size.height());
+  glClearColor(0.2f, 0.4f, 0.6f, 1.0f);  // #336699
+  glClear(GL_COLOR_BUFFER_BIT);
+  glFlush();
+
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glDeleteFramebuffers(1, &fbo);
+  glBindTexture(GL_TEXTURE_2D, 0);
+  glDeleteTextures(1, &texture);
+
+  return true;
