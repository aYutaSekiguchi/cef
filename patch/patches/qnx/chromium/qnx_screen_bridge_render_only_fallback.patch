+QnxFrameImporter::ImportCompatibilityReport
+QnxFrameImporter::ValidateIncomingFrameForBridge(
+    const qnx::QnxDmaBufFrame& frame) const {
+  ImportCompatibilityReport report;
+
+  if (frame.width == 0 || frame.height == 0) {
+    report.reason = "frame dimensions must be non-zero";
+    return report;
+  }
+
+  if (frame.planes.empty()) {
+    report.reason = "frame has no planes";
+    return report;
+  }
+
+  if (!frame.planes[0]) {
+    report.reason = "plane[0] metadata is null";
+    return report;
+  }
+
+  if (!frame.planes[0]->fd.is_valid()) {
+    report.reason = "plane[0] fd handle is invalid";
+    return report;
+  }
+
+  if (frame.planes[0]->stride == 0) {
+    report.reason = "plane[0] stride is zero";
+    return report;
+  }
+
+  if (frame.planes[0]->size == 0) {
+    report.reason = "plane[0] size is zero";
+    return report;
+  }
+
+  if (frame.planes[0]->offset > frame.planes[0]->size) {
+    report.reason = "plane[0] offset exceeds plane size";
+    return report;
+  }
+
+  if (frame.modifier != 0) {
+    report.reason = "non-linear modifier is not supported by importer";
+    return report;
+  }
+
+  report.compatible = true;
+  report.reason = "compatible";
+  return report;
+}
