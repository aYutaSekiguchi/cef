+int EventFlagsFromQnxModifiers(int modifiers) {
+  int flags = EF_NONE;
+  if (modifiers & (KEYMOD_SHIFT | KEYMOD_SHIFT_LOCK))
+    flags |= EF_SHIFT_DOWN;
+  if (modifiers & (KEYMOD_CTRL | KEYMOD_CTRL_LOCK))
+    flags |= EF_CONTROL_DOWN;
+  if (modifiers & (KEYMOD_ALT | KEYMOD_ALT_LOCK))
+    flags |= EF_ALT_DOWN;
+  if (modifiers & (KEYMOD_ALTGR | KEYMOD_ALTGR_LOCK))
+    flags |= EF_ALTGR_DOWN;
+  if (modifiers & KEYMOD_CAPS_LOCK)
+    flags |= EF_CAPS_LOCK_ON;
+  if (modifiers & KEYMOD_NUM_LOCK)
+    flags |= EF_NUM_LOCK_ON;
+  if (modifiers & KEYMOD_SCROLL_LOCK)
+    flags |= EF_SCROLL_LOCK_ON;
+  return flags;
+}
