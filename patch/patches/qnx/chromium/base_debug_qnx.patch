@@ -34,10 +35,18 @@ template <typename Range, typename Proj = std::identity>
                std::indirect_result_t<Proj, std::ranges::iterator_t<Range>>>
 ListValue ToValueList(Range&& range, Proj proj = {}) {
   auto container = ListValue::with_capacity(std::ranges::size(range));
+#if BUILDFLAG(IS_QNX)
+  // QNX SDP 8's sysroot libc++ lacks std::ranges::for_each. Keep the
+  // workaround scoped to QNX so other platforms retain the upstream path.
+  for (auto&& value : std::forward<Range>(range)) {
+    container.Append(std::invoke(proj, std::forward<decltype(value)>(value)));
+  }
+#else
   std::ranges::for_each(
       std::forward<Range>(range),
       [&]<typename T>(T&& value) { container.Append(std::forward<T>(value)); },
       std::move(proj));
+#endif
   return container;
 }
 
