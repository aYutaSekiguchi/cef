+void QnxGpuPlatformSupportHost::ResizeWidget(
+    gfx::AcceleratedWidget widget,
+    const gfx::Size& size) {
+  DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
+
+  if (!gpu_control_remote_ || !window_manager_ || size.IsEmpty())
+    return;
+
+  const QnxWidgetRecord* record = window_manager_->GetWidgetRecord(widget);
+  if (!record || !record->gpu_attached)
+    return;
+
+  gpu_control_remote_->ResizeWidget(widget, record->generation, size);
+  QNX_GPU_TRACE_LOG(INFO) << "ResizeWidget: widget=" << widget
+             << " generation=" << record->generation
+             << " size=" << size.width() << "x" << size.height()
+             << " sent to GPU";
+}
+
