diff --git third_party/dav1d/BUILD.gn third_party/dav1d/BUILD.gn
index c521fe2c68c4c8204c59ad044eb0f2004a3dd8e2..c3c4290cbe8a7e88d232dfc7c15508010ed9d3ab 100644
--- third_party/dav1d/BUILD.gn
+++ third_party/dav1d/BUILD.gn
@@ -83,13 +83,32 @@ config("dav1d_config") {
   if (is_win && !is_clang) {
     include_dirs += [ "libdav1d/include/compat/msvc" ]
   }
+  if (is_qnx) {
+    # QNX SDP 8's sysroot headers (sys/compiler_gnu.h, sys/platform.h,
+    # sys/ntohdr.h) require a set of CPU/OS/endian defines to be
+    # present or they #error out with messages like
+    #   'Endian not defined' / 'not configured for target' /
+    #   'not configured for CPU' / '_NTO_CPU_HDR_DIR_(platform.h)
+    #   file not found'.
+    # The C/C++ toolchain does this via build/toolchain/qnx/*'s
+    # _target_flags, but the bindgen subprocess that
+    # crabbyavif_dav1d_bindings uses to parse the dav1d headers does
+    # not pick those up. So define them here, where crabbyavif
+    # consumes dav1d_config.
+    defines = [
+      "__LITTLEENDIAN__",
+      "__QNXNTO__",
+      "__QNX__",
+      "__X86_64__",
+    ]
+  }
 }
 
-dav1d_copts = [
-  "-D_FILE_OFFSET_BITS=64",
-  "-D_POSIX_C_SOURCE=200112L",
-]
-
+dav1d_copts = [ "-D_FILE_OFFSET_BITS=64" ]
+# The QNX toolchain already defines _POSIX_C_SOURCE=200809L.
+if (!is_qnx) {
+  dav1d_copts += [ "-D_POSIX_C_SOURCE=200112L" ]
+}
 if (is_win) {
   if (!is_clang) {
     dav1d_copts += [ "/wd4028" ]
