diff --git a/BUILD.gn b/BUILD.gn
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -29,6 +29,19 @@ config("skia_public") {
   if (is_linux) {
     defines += [ "SK_R32_SHIFT=16" ]
   }
+  if (is_linux || is_chromeos || is_qnx) {
+    defines += [
+      # QNX builds reach this branch via `is_linux = current_os == "linux" ||
+      # is_qnx` in build/config/BUILDCONFIG.gn. Pre-define SK_BUILD_FOR_UNIX
+      # here so that third_party/skia/include/private/base/SkFeatures.h
+      # skips its platform auto-detection block. Without this, QNX does not
+      # match any of the __linux / __GLIBC__ / __unix__ / __FreeBSD__ / ...
+      # branches and falls into the SK_BUILD_FOR_MAC else branch, causing
+      # third_party/skia/src/base/SkSemaphore.cpp to #include
+      # <dispatch/dispatch.h> (Apple GCD), which QNX SDP 8 does not ship.
+      "SK_BUILD_FOR_UNIX",
+    ]
+  }
   if (skia_enable_optimize_size) {
     defines += [ "SK_ENABLE_OPTIMIZE_SIZE" ]
   }
