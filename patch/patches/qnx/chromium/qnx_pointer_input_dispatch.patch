+QnxWindow* QnxWindowManager::LookupWindowByScreenWin(void* screen_win) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  if (!screen_win)
+    return nullptr;
+  for (const auto& [widget, record] : records_) {
+    if (record.screen_win == screen_win) {
+      return record.window;
+    }
+  }
+  return nullptr;
+}
