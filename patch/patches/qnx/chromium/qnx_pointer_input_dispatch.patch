+bool QnxPlatformEventSource::DispatchPointerEvent(screen_window_t win) {
+  // QNX_INPUT: one-shot Release-visible marker at entry, BEFORE the
+  // window_manager_/win guard. Confirms that SCREEN_EVENT_POINTER
+  // reached the dispatcher even when Screen delivered a pointer event
+  // without a source window (e.g. a virtual/offscreen device) which
+  // would otherwise fall through the guard and never emit a marker.
+  // Separates "pointer events arrive" from "target window resolves".
+  if (first_pointer_marker_) {
+    first_pointer_marker_ = false;
+    LOG(INFO) << "QNX_INPUT: first pointer event win=" << win;
+  }
+
+  if (!window_manager_ || !win) {
+    // No source window recorded by Screen; cannot resolve a target. This
+    // typically means the event came from a non-window context (e.g. a
+    // virtual device) and needs screen-point hit testing, which is out of
+    // scope for the pointer MVP.
+    VLOG(1) << "QnxPlatformEventSource: POINTER skipped (no source window="
+            << win << " or no window_manager)";
+    return false;
+  }
+
+  // Read the current pointer position and button mask from the Screen event.
+  int pos[2] = {0, 0};
+  int buttons = 0;
+  if (screen_get_event_property_iv(screen_event_, SCREEN_PROPERTY_POSITION,
+                                  pos) != 0) {
+    // Property read failure is unusual; warn so the missing log under
+    // --ozone-qnx-gpu-trace is not mistaken for "no pointer events".
+    int saved_errno = errno;
+    LOG(WARNING) << "QnxPlatformEventSource: POINTER "
+                    "SCREEN_PROPERTY_POSITION read failed errno="
+                 << saved_errno << " (" << SafeStrError(saved_errno) << ")";
+    return false;
+  }
+  if (screen_get_event_property_iv(screen_event_, SCREEN_PROPERTY_BUTTONS,
+                                  &buttons) != 0) {
+    int saved_errno = errno;
+    LOG(WARNING) << "QnxPlatformEventSource: POINTER "
+                    "SCREEN_PROPERTY_BUTTONS read failed errno="
+                 << saved_errno << " (" << SafeStrError(saved_errno) << ")";
+    return false;
+  }
+
+  // Property-read success: detailed pointer state is always VLOG(1) so
+  // first and subsequent events look the same and Release logs stay
+  // readable.
+  VLOG(1) << "QNX_INPUT: POINTER win=" << win << " pos=(" << pos[0] << ","
+          << pos[1] << ") buttons=0x" << std::hex << buttons << std::dec;
+
+  // Resolve the target QnxWindow. The Screen event's source window is the
+  // browser-owned QnxWindow under the cursor.
+  QnxWindow* window = window_manager_->LookupWindowByScreenWin(win);
+  if (!window) {
+    LOG(WARNING) << "QnxPlatformEventSource: POINTER for unknown "
+                    "screen_win="
+                 << win << " pos=(" << pos[0] << "," << pos[1] << ")";
+    return false;
+  }
+
+  // Compute local coordinates relative to the window bounds; root location
+  // stays in screen coordinates.
+  gfx::Rect bounds = window->GetBoundsInPixels();
+  gfx::PointF location(pos[0] - bounds.x(), pos[1] - bounds.y());
+  gfx::PointF root_location(static_cast<float>(pos[0]),
+                            static_cast<float>(pos[1]));
+
+  // SCREEN_PROPERTY_TIMESTAMP is the realtime clock in milliseconds since
+  // epoch (per screen.h); fall back to Now() if the property is not
+  // populated.
+  long long timestamp_ms = 0;
+  screen_get_event_property_llv(screen_event_, SCREEN_PROPERTY_TIMESTAMP,
+                               &timestamp_ms);
+  base::TimeTicks timestamp = timestamp_ms > 0
+      ? base::TimeTicks::UnixEpoch() +
+            base::Milliseconds(static_cast<int64_t>(timestamp_ms))
+      : base::TimeTicks::Now();
+
+  // Translate QNX button bits to Chromium EventFlags. The QNX layout is
+  // contiguous bits 0/1/2 while Chromium places them at bits 11/12/13.
+  int flags = 0;
+  if (buttons & SCREEN_LEFT_MOUSE_BUTTON)
+    flags |= EF_LEFT_MOUSE_BUTTON;
+  if (buttons & SCREEN_MIDDLE_MOUSE_BUTTON)
+    flags |= EF_MIDDLE_MOUSE_BUTTON;
+  if (buttons & SCREEN_RIGHT_MOUSE_BUTTON)
+    flags |= EF_RIGHT_MOUSE_BUTTON;
+
+  bool any_dispatched = false;
+
+  // Emit a move event whenever the position changes or any button changed
+  // state (a press/release always implies a position update worth
+  // recording). On the very first POINTER sample we also emit a move so
+  // downstream targets start with a coherent cursor position.
+  if (!has_pointer_state_ || pos[0] != last_pointer_x_ ||
+      pos[1] != last_pointer_y_ || buttons != last_pointer_buttons_) {
+    MouseEvent move_event(EventType::kMouseMoved, location, root_location,
+                          timestamp, flags, /*changed_button_flags=*/0);
+    Event::DispatcherApi(&move_event).set_target(window);
+    synth_moved_++;
+    DispatchEvent(&move_event);
+    any_dispatched = true;
+  }
+
+  // Emit one press or release per transitioned button. Tracking the previous
+  // mask ensures exactly one edge event per physical transition even if
+  // Screen coalesces updates.
+  struct ButtonTransition {
+    int qnx_bit;
+    int chromium_flag;
+  };
+  const ButtonTransition kButtons[] = {
+      {SCREEN_LEFT_MOUSE_BUTTON, EF_LEFT_MOUSE_BUTTON},
+      {SCREEN_MIDDLE_MOUSE_BUTTON, EF_MIDDLE_MOUSE_BUTTON},
+      {SCREEN_RIGHT_MOUSE_BUTTON, EF_RIGHT_MOUSE_BUTTON},
+  };
+  for (const auto& b : kButtons) {
+    bool was_down =
+        has_pointer_state_ && (last_pointer_buttons_ & b.qnx_bit) != 0;
+    bool is_down = (buttons & b.qnx_bit) != 0;
+    if (was_down == is_down)
+      continue;
+    EventType type =
+        is_down ? EventType::kMousePressed : EventType::kMouseReleased;
+    // Both press and release edge events include the transitioned button in
+    // the MouseEvent flags. This matches the Linux/evdev contract where
+    // |flags| reports "the button is currently in this state during this
+    // event" for one cycle; the explicitly-tracked |changed_button_flags|
+    // argument tells consumers which edge fired.
+    int button_flags = flags | b.chromium_flag;
+    MouseEvent button_event(type, location, root_location, timestamp,
+                            button_flags, /*changed_button_flags=*/b.chromium_flag);
+    Event::DispatcherApi(&button_event).set_target(window);
+    if (is_down)
+      synth_pressed_++;
+    else
+      synth_released_++;
+    DispatchEvent(&button_event);
+    any_dispatched = true;
+  }
+
+  // ---- Phase 5: SCREEN_PROPERTY_MOUSE_WHEEL / MOUSE_HORIZONTAL_WHEEL ----
+  // QNX semantics (per screen.h): vertical raw up = negative / down = positive;
+  // horizontal raw left = negative / right = positive. Chromium offset
+  // convention (event.h:655-656): y_offset > 0 / x_offset > 0 means scroll
+  // up / left. Translation rule: Chromium_offset = -raw * kWheelDelta.
+  // Wheel=0 path leaves the existing MouseEvent sequence untouched.
+  int wheel_v = 0;
+  int wheel_h = 0;
+  if (screen_get_event_property_iv(
+          screen_event_, SCREEN_PROPERTY_MOUSE_WHEEL, &wheel_v) != 0) {
+    wheel_v = 0;
+  }
+  if (screen_get_event_property_iv(
+          screen_event_, SCREEN_PROPERTY_MOUSE_HORIZONTAL_WHEEL,
+          &wheel_h) != 0) {
+    wheel_h = 0;
+  }
+  if (wheel_v != 0 || wheel_h != 0) {
+    if (first_wheel_marker_) {
+      first_wheel_marker_ = false;
+      LOG(INFO) << "QNX_INPUT: first wheel event raw_v=" << wheel_v
+                << " raw_h=" << wheel_h
+                << " (Chromium offset = -raw * MouseWheelEvent::kWheelDelta)";
+    }
+    gfx::Vector2d offset(-wheel_h * MouseWheelEvent::kWheelDelta,
+                         -wheel_v * MouseWheelEvent::kWheelDelta);
+    MouseWheelEvent wheel_event(
+        offset, location, root_location, timestamp, /*flags=*/0,
+        /*changed_button_flags=*/0);
+    Event::DispatcherApi(&wheel_event).set_target(window);
+    if (offset.y() != 0)
+      synth_wheel_v_++;
+    if (offset.x() != 0)
+      synth_wheel_h_++;
+    DispatchEvent(&wheel_event);
+    any_dispatched = true;
+  }
+
+  // Update tracked state for the next transition.
+  last_pointer_buttons_ = buttons;
+  last_pointer_x_ = pos[0];
+  last_pointer_y_ = pos[1];
+  has_pointer_state_ = true;
+
+  return any_dispatched;
+}
+
 }  // namespace ui
