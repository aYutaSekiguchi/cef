diff --git BUILD.gn BUILD.gn
index 8f6f13e189b4ef998bf2f845f27b8190c532a664..aad204d86ef6f2b8e8f3022ca081ad89de6e5538 100644
--- BUILD.gn
+++ BUILD.gn
@@ -241,6 +241,28 @@ target(link_target_type, "ffmpeg_internal") {
 
   # So we can append below and assume they're defined.
   cflags = []
+  if (is_qnx) {
+    # The QNX toolchain (build/toolchain/qnx/BUILD.gn) forces
+    # -D_POSIX_C_SOURCE=200809L globally so that QNX sysroot headers
+    # expose strdup / dev_t / uid_t / gid_t / etc. (see
+    # cef/docs/qnx/history/archive/plan.md, items #5 and "sys/stat.h
+    # types undefined"). ffmpeg_internal's `defines` array, however,
+    # declares _POSIX_C_SOURCE=200112 + _XOPEN_SOURCE=600 because the
+    # bundled FFmpeg source targets XPG/SUSv3. The combination
+    # _XOPEN_SOURCE=600 + _POSIX_C_SOURCE > 200112 is rejected by
+    # QNX's /usr/include/sys/platform.h:163-165.
+    #
+    # Force-include a tiny shim that conditionally overrides
+    # _POSIX_C_SOURCE to 200112 when FFMPEG_CONFIGURATION is defined
+    # (it is, from this target's defines array). clang applies all
+    # command-line -D flags first and then -include files, so the
+    # shim's #define wins over the toolchain's later -D_POSIX_C_SOURCE
+    # for FFmpeg TUs only. All other QNX code keeps 200809L.
+    cflags += [
+      "-include",
+      rebase_path("//build/config/qnx/qnx_ffmpeg_compat.h", root_build_dir),
+    ]
+  }
   ldflags = []
   libs = []
   deps = [
@@ -362,8 +384,10 @@ target(link_target_type, "ffmpeg_internal") {
       libs += [
         "m",
         "z",
-        "rt",
       ]
+      if (!is_qnx) {
+        libs += [ "rt" ]
+      }
     }
     if (is_component_ffmpeg) {
       # Export all symbols when building as component.
