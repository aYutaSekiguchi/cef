+// static
+Stack::StackSlot Stack::ObtainCurrentThreadStackStart() {
+  struct _thread_local_storage* tls = __tls();
+  if (!tls || !tls->__stackaddr || tls->__stacksize == 0) return nullptr;
+  return reinterpret_cast<uint8_t*>(tls->__stackaddr) + tls->__stacksize;
+}
