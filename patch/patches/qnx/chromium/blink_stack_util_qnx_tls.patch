diff --git third_party/blink/renderer/platform/wtf/stack_util.cc third_party/blink/renderer/platform/wtf/stack_util.cc
index f9e1600a34034a0bf7b2eab21e2e837ac698314b..dad67d87f2e908a843ad23fb33c421c1b714b8b9 100644
--- third_party/blink/renderer/platform/wtf/stack_util.cc
+++ third_party/blink/renderer/platform/wtf/stack_util.cc
@@ -14,6 +14,8 @@
 #include <intrin.h>
 #include <stddef.h>
 #include <winnt.h>
+#elif BUILDFLAG(IS_QNX)
+#include <sys/storage.h>
 #elif defined(__GLIBC__)
 extern "C" void* __libc_stack_end;  // NOLINT
 #endif
@@ -92,6 +94,12 @@ size_t GetUnderestimatedStackSize() {
 #endif
   }
   return pthread_get_stacksize_np(pthread_self());
+#elif BUILDFLAG(IS_QNX)
+  struct _thread_local_storage* tls = __tls();
+  if (!tls || tls->__stacksize == 0) {
+    return 512 * 1024;
+  }
+  return tls->__stacksize;
 #elif BUILDFLAG(IS_WIN) && defined(COMPILER_MSVC)
   return Threading::ThreadStackSize();
 #else
@@ -140,6 +148,14 @@ void* GetStackStartImpl() {
 #endif
 #elif BUILDFLAG(IS_APPLE)
   return pthread_get_stackaddr_np(pthread_self());
+#elif BUILDFLAG(IS_QNX)
+  struct _thread_local_storage* tls = __tls();
+  if (!tls || !tls->__stackaddr || tls->__stacksize == 0) {
+    return nullptr;
+  }
+  // SAFETY: QNX thread metadata provides the current thread's stack base and
+  // size, matching the v8 QNX stack-top implementation.
+  return reinterpret_cast<uint8_t*>(tls->__stackaddr) + tls->__stacksize;
 #elif BUILDFLAG(IS_WIN) && defined(COMPILER_MSVC)
 // On Windows stack limits for the current thread are available in
 // the thread information block (TIB).
