diff --git build/rust/rust_bindgen_generator.gni build/rust/rust_bindgen_generator.gni
index 57167634f5803..e34f9665808fa 100644
--- build/rust/rust_bindgen_generator.gni
+++ build/rust/rust_bindgen_generator.gni
@@ -265,6 +265,64 @@ template("rust_bindgen_generator") {
       args += [ "-fparse-all-comments" ]
     }
 
+    if (is_qnx) {
+      # The QNX clang toolchain delivers its --target and the QNX_NTO/QNX
+      # platform defines via extra_cflags/extra_cxxflags that the C/C++
+      # compile action pulls in. rust_bindgen, however, runs libclang
+      # through run_bindgen.py using cflags / cflags_c, and on QNX those
+      # cflags do NOT carry the --target flag nor the platform defines, so
+      # libclang parses QNX sysroot headers with no endianness or target
+      # selected and fails with:
+      #   sys/compiler_gnu.h:60: error: Endian not defined
+      #   sys/platform.h:428: error: not configured for target
+      #   stdint.h:70: error: unknown type name '_Intleast8t'
+      #
+      # Inject the same target / defines the regular C++ compile uses
+      # so libclang parses the QNX headers consistently.
+      if (current_cpu == "x64") {
+        qnx_target = "x86_64-unknown-nto"
+      } else if (current_cpu == "arm64") {
+        qnx_target = "aarch64-unknown-nto"
+      } else {
+        qnx_target = ""
+      }
+      qnx_cpu_def = ""
+      if (current_cpu == "x64") {
+        qnx_cpu_def = "-D__X86_64__"
+      } else if (current_cpu == "arm64") {
+        qnx_cpu_def = "-D__AARCH64EL__"
+      }
+      if (qnx_target != "") {
+        args += [
+          "--target=" + qnx_target,
+          "-D__QNXNTO__",
+          "-D__QNX__",
+          "-D__LITTLEENDIAN__",
+          qnx_cpu_def,
+        ]
+        # bindgen invokes libclang with --no-include-path-detection, so
+        # the default include search is disabled. Chromium QNX toolchain
+        # uses libc++ (c++/v1), and the QNX target sysroot does not ship
+        # a C11 <stdalign.h> in target/qnx/usr/include; it only lives in
+        # the bundled GCC 12.2.0 host tree (which we cannot rely on from
+        # the clang bindgen run) and inside clang's own resource dir.
+        # Inject clang's resource include dir as a system include so the
+        # C11 stdalign.h resolves consistently for the C-mode bindgen run
+        # (see https://www.qnx.com/developers/docs/8.0/com.qnx.doc.neutrino
+        # .lib_ref/topic/a/alignas.html -- QNX documents alignas/alignof but
+        # the sysroot only exposes them via c++/v1/cstdalign, not as a
+        # bare C header).
+        if (defined(clang_base_path) && defined(clang_version)) {
+          _qnx_resource_include = clang_base_path + "/lib/clang/" +
+                                  clang_version + "/include"
+          args += [
+            "-isystem",
+            rebase_path(_qnx_resource_include, root_build_dir),
+          ]
+        }
+      }
+    }
+
     # Default configs include "-fvisibility=hidden", and for some reason this
     # causes bindgen not to emit function bindings. Override it.
     if (!is_win) {
