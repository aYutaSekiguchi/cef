@@ -20,11 +20,37 @@
 #include <unistd.h>
 
 #include <array>
+#include <fstream>
+#include <stdlib.h>
 
 namespace angle
 {
 std::string GetExecutablePath()
 {
+#if defined(__QNX__)
+    // Honor CHROME_EXE_PATH as an explicit override, but normal QNX test runs
+    // resolve the executable path via /proc/self/exefile below. QNX does not
+    // provide Linux's /proc/self/exe symlink.
+    const char *executablePath = getenv("CHROME_EXE_PATH");
+    if (executablePath != nullptr && executablePath[0] != '\0')
+    {
+        return executablePath;
+    }
+
+    // QNX's procfs exposes the executable path via a regular file instead of a
+    // symlink.  Fall back to reading it directly when available.
+    std::ifstream exefile("/proc/self/exefile");
+    if (exefile)
+    {
+        std::string path;
+        std::getline(exefile, path);
+        if (!path.empty())
+        {
+            return path;
+        }
+    }
+#endif
+
     // We cannot use lstat to get the size of /proc/self/exe as it always returns 0
     // so we just use a big buffer and hope the path fits in it.
     char path[4096];
