diff --git third_party/boringssl/BUILD.gn third_party/boringssl/BUILD.gn
--- third_party/boringssl/BUILD.gn
+++ third_party/boringssl/BUILD.gn
@@ -99,7 +99,19 @@ if (is_msan) {
   source_set("test_support_asm") {
     visibility = [ ":*" ]
     testonly = true
   }
+} else if (is_qnx) {
+  # QNX targets use the generic C implementation. The generated GAS assembly
+  # is for Linux/Apple/Windows assembler environments and clang can fail while
+  # materializing temporary files for these .S inputs under the QNX toolchain.
+  source_set("boringssl_asm") {
+    visibility = [ ":*" ]
+    public_configs = [ ":no_asm_config" ]
+  }
+  source_set("test_support_asm") {
+    visibility = [ ":*" ]
+    testonly = true
+  }
 } else if (is_win && (current_cpu == "x86" || current_cpu == "x64")) {
   # Windows' x86 and x86_64 assembly is built with NASM.
   import("//third_party/nasm/nasm_assemble.gni")
