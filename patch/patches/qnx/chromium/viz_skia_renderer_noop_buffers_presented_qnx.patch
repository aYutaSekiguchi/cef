   read_lock_release_fence_overlay_locks_.pop_front();
+#endif
 }
 
 void SkiaRenderer::DidReceiveReleasedOverlays(
@@ -1249,6 +1255,12 @@ void SkiaRenderer::DidReceiveReleasedOverlays(
     }
     awaiting_release_overlay_locks_.erase(iter);
   }
+#elif BUILDFLAG(IS_QNX)
+  // QNX OOP GPU: the pbuffer-backed offscreen surface doesn't use native
