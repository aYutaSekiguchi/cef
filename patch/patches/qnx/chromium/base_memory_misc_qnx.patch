@@ -26,6 +26,32 @@
 #include "base/time/time.h"
 #include "base/trace_event/heap_profiler.h"
 #include "base/trace_event/trace_event.h"
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_QNX)
+// QNX epoll.h does not define EPOLLRDHUP or EPOLLONESHOT.
+//
+// EPOLLRDHUP (0x2000): "peer closed write half". QNX epoll will never
+// generate this event; defining it lets the kEpollToPollEvents table and
+// event-mask comparisons compile without matching anything at runtime.
+//
+// EPOLLONESHOT (0x40000000): "disable fd after one event". QNX epoll_ctl
+// does not support this flag at the kernel level.  We keep the constant so
+// that registered_events can track one-shot intent, but we strip it before
+// every epoll_ctl() call and compensate by calling StopEpollEvent() manually
+// whenever a one-shot event fires (see UpdateEpollEvent).
+//
+// POLLRDHUP: map to POLLHUP, the closest poll(2) equivalent on QNX.
+#ifndef EPOLLRDHUP
+#define EPOLLRDHUP 0x2000u
+#endif
+#ifndef EPOLLONESHOT
+#define EPOLLONESHOT 0x40000000u
+#endif
+#ifndef POLLRDHUP
+#define POLLRDHUP POLLHUP
+#endif
+#endif  // BUILDFLAG(IS_QNX)
 
 #if DCHECK_IS_ON()
 #include <iomanip>
@@ -323,7 +349,15 @@ void MessagePumpEpoll::AddEpollEvent(EpollEventEntry& entry) {
   DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
   DCHECK(!entry.stopped);
   const uint32_t events = entry.ComputeActiveEvents();
+#if BUILDFLAG(IS_QNX)
+  // QNX epoll_ctl does not support EPOLLONESHOT at the kernel level.
+  // Strip the bit before the syscall; one-shot behaviour is emulated in
+  // UpdateEpollEvent() by calling StopEpollEvent() after each event fires.
+  const uint32_t kernel_events = events & ~static_cast<uint32_t>(EPOLLONESHOT);
+  epoll_event event{.events = kernel_events, .data = {.ptr = &entry}};
+#else
   epoll_event event{.events = events, .data = {.ptr = &entry}};
+#endif
   int rv = epoll_ctl(epoll_.get(), EPOLL_CTL_ADD, entry.fd, &event);
 #if DCHECK_IS_ON()
   // TODO(361611793): Remove these debug logs after resolving the issue.
@@ -360,6 +394,12 @@ void MessagePumpEpoll::UpdateEpollEvent(EpollEventEntry& entry) {
   if (!entry.stopped) {
     if (events == 0) {
       // There is no active interest now.
+#if BUILDFLAG(IS_QNX)
+      // QNX epoll does not support EPOLLONESHOT at kernel level, so the fd is
+      // never auto-disabled after a one-shot event. Always call StopEpollEvent
+      // to explicitly remove it, regardless of the one-shot flag.
+      StopEpollEvent(entry);
+#else
       // We don't have to call epoll_ctl() if the last event was registered as
       // one-shot since the fd has already been disabled.
       if (!(entry.registered_events & EPOLLONESHOT)) {
@@ -374,13 +414,20 @@ void MessagePumpEpoll::UpdateEpollEvent(EpollEventEntry& entry) {
         CHECK(poll_entry != pollfds_.end());
         poll_entry->events = 0;
       }
+#endif  // BUILDFLAG(IS_QNX)
       return;
     }
     if (events == entry.registered_events && !(events & EPOLLONESHOT)) {
       // Persistent events don't need to be modified if no bits are changing.
       return;
     }
+#if BUILDFLAG(IS_QNX)
+    // Strip EPOLLONESHOT before passing to QNX epoll_ctl.
+    epoll_event event{.events = events & ~static_cast<uint32_t>(EPOLLONESHOT),
+                      .data = {.ptr = &entry}};
+#else
     epoll_event event{.events = events, .data = {.ptr = &entry}};
+#endif
     int rv = epoll_ctl(epoll_.get(), EPOLL_CTL_MOD, entry.fd, &event);
     DPCHECK(rv == 0);
 #if DCHECK_IS_ON()
