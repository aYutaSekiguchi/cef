--- /dev/null
+++ content/utility/on_device_model/features.gni
@@ -0,0 +1,15 @@
+# Copyright 2026 The Chromium Authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//services/on_device_model/on_device_model.gni")
+import("//ui/gl/features.gni")
+
+declare_args() {
+  # Master switch for the on-device model service integration in content/.
+  # Defaults to true only when both the platform supports on-device models
+  # AND Dawn (the GPU backend this feature depends on) is enabled.
+  # - use_on_device_model_service: platform-level availability
+  # - use_dawn: GPU backend required by the ML service
+  # Either being false disables this feature by default.
+  enable_on_device_model = use_on_device_model_service && use_dawn
+}
