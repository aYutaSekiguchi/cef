# QNX-local mojom interfaces for Browser<->GPU DMAbuf frame transport.
# Phase 5: compile-safe mojom definitions and generated-code wiring only.
# GPU producer runtime and DMAbuf export/import logic deferred to later substeps.
#
# This BUILD.gn defines a mojom target that can be built independently or as
# a dep of ui/ozone/platform/qnx:qnx.

import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [
    "qnx_gpu.mojom",
  ]

  public_deps = [
    "//mojo/public/mojom/base",
    "//ui/gfx/geometry/mojom",
    "//ui/gfx/mojom",
  ]
}
